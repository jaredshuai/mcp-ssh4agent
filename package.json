{
  "name": "mcp-ssh4agent",
  "version": "4.0.0",
  "description": "MCP SSH4Agent: Model Context Protocol server for SSH remote server management. Control SSH connections from any MCP-compatible AI agent (Claude Code, Codex, Cursor, Cline, etc.) - execute commands, transfer files, database operations, backups, health monitoring, and DevOps automation. NEW: Tool activation system reduces context usage by 92%",
  "main": "dist/src/index.js",
  "files": ["dist/", "README.md", "LICENSE", "CHANGELOG.md"],
  "bin": {
    "mcp-ssh4agent": "dist/src/index.js",
    "ssh4agent": "dist/cli/ssh-manager.js"
  },
  "type": "module",
  "scripts": {
    "start": "node src/index.ts",
    "setup": "npm install",
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('fs');fs.rmSync('dist/profiles',{recursive:true,force:true});fs.cpSync('profiles','dist/profiles',{recursive:true});fs.cpSync('package.json','dist/package.json')\"",
    "prepack": "npm run build",
    "test": "npm run test:profiles && npm run test:aliases && npm run test:hooks && npm run test:tools && npm run test:policy && npm run test:shellquote && npm run test:ping && npm run test:config && npm run test:fieldnames && npm run test:serverfields && npm run test:groups && npm run test:agentforward && npm run test:lifecycle && npm run test:tunnel && npm run test:sync && npm run test:sync-path && npm run test:dbquoting && npm run test:dbinjection && npm run test:dbrowcount && npm run test:cli && npm run test:resolve && npm run test:tunnelremote && npm run test:pool && npm run test:dumpcmd && npm run test:funnel && npm run test:configuni && npm run test:state && npm run test:managers",
    "test:profiles": "node tests/test-profiles.js",
    "test:aliases": "node tests/test-command-aliases.js",
    "test:hooks": "node tests/test-hooks.js",
    "test:tools": "node tests/test-tool-registry.js",
    "test:policy": "node tests/test-policy.js",
    "test:shellquote": "node tests/test-shell-quote.js",
    "test:ping": "node tests/test-ssh-ping.js",
    "test:config": "node tests/test-server-config-manager.js",
    "test:fieldnames": "node tests/test-config-field-names.js",
    "test:serverfields": "node tests/test-server-fields.ts",
    "test:groups": "node tests/test-server-groups.js",
    "test:agentforward": "node tests/test-agent-forward.js",
    "test:lifecycle": "node tests/test-lifecycle.js",
    "test:tunnel": "node tests/test-tunnel-listen.js",
    "test:sync": "node tests/test-sync-stats.js",
    "test:sync-path": "node tests/test-rsync-path.js",
    "test:dbquoting": "node tests/test-database-query-quoting.js",
    "test:dbinjection": "node tests/test-database-injection.js",
    "test:dbrowcount": "node tests/test-database-row-count.js",
    "test:cli": "node tests/test-cli-commands.js",
    "test:resolve": "node tests/test-resolve-server.js",
    "test:tunnelremote": "node tests/test-tunnel-remote.js",
    "test:tunnelguard": "node tests/test-tunnel-guard.js",
    "test:pool": "node tests/test-connection-pool.js",
    "test:dumpcmd": "node tests/test-dump-command-builder.js",
    "test:funnel": "node tests/test-policy-funnel.js",
    "test:configuni": "node tests/test-config-unification.js",
    "test:state": "node tests/test-state-files.js",
    "test:managers": "node tests/test-managers-interface.js",
    "test:all": "npm test && npm run typecheck && npm run validate",
    "validate": "node scripts/validate.ts",
    "install-cli": "node scripts/install.ts",
    "setup-hooks": "node scripts/setup-hooks.ts",
    "demo": "node scripts/demo.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "npx @biomejs/biome lint .",
    "lint:fix": "npx @biomejs/biome check --write .",
    "format": "npx @biomejs/biome format --write ."
  },
  "keywords": [
    "mcp",
    "ssh",
    "mcp-ssh",
    "mcp ssh",
    "ssh-mcp",
    "ssh mcp",
    "model-context-protocol-ssh",
    "mcp-server",
    "mcp server ssh",
    "claude-code",
    "claude-ssh",
    "claude-code-ssh",
    "openai-codex",
    "codex",
    "model-context-protocol",
    "remote-server",
    "ssh4agent",
    "remote-ssh",
    "ssh-automation",
    "deployment",
    "devops",
    "automation",
    "backup",
    "restore",
    "health-monitoring",
    "database",
    "mysql",
    "postgresql",
    "mongodb",
    "profiles",
    "hooks",
    "aliases",
    "toml",
    "ai-assistant",
    "ai-tools",
    "llm-tools"
  ],
  "author": "jaredshuai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaredshuai/mcp-ssh4agent.git"
  },
  "bugs": {
    "url": "https://github.com/jaredshuai/mcp-ssh4agent/issues"
  },
  "homepage": "https://github.com/jaredshuai/mcp-ssh4agent#readme",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.5",
    "ssh2": "^1.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "knip": "^5.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
